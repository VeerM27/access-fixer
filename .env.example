GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
ACCESS_FIXER_MODEL=gemini-3.6-flash
# Used for a round only if the main model is overloaded (503) or out of quota (429), for that request only.
ACCESS_FIXER_FALLBACK_MODEL=gemini-3.5-flash-lite
GITHUB_PAT=
# Dev only: lets the agent audit a local folder. Leave unset in Cloud Run.
ACCESS_FIXER_ALLOW_LOCAL=1
